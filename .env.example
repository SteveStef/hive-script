# Copy to .env (which git ignores). These match docker-compose.yml.
DATABASE_URL=postgres://hive:hive@localhost:5433/hive
TEST_DATABASE_URL=postgres://hive:hive@localhost:5433/hive_test
PORT=3001
# Milliseconds per game tick on the server: 133 is 7.5 ticks a second, half single player's 1x. Lower it to watch faster.
GAME_TICK_MS=133
